  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "description": "Dependency-free wire types and constants for the Affordance HTTP contract.",
