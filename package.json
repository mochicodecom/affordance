{
  "name": "affordance",
  "private": true,
  "author": "Mochicode LLC (https://mochicode.com)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "prepare": "pnpm build && git config core.hooksPath .githooks",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "test": "pnpm build && vitest run",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "build": "pnpm -r --filter @affordance/core --filter @affordance/pg run build",
    "release:pack": "pnpm build && node scripts/release/pack.mjs",
    "release:smoke": "node scripts/release/smoke.mjs",
    "release:check": "pnpm lint && pnpm typecheck && pnpm --filter @affordance/reference-app ui:build && pnpm test && pnpm release:pack && pnpm release:smoke",
    "release:publish": "node scripts/release/publish.mjs"
  }
}
